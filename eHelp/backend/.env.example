# Where uploaded files and the SQLite database live.
EHELP_DATA_DIR=./data
# Local development only: treat every request as this admin when no iv-user header is present.
EHELP_DEV_ADMIN=0
# Maximum upload size in MB.
EHELP_MAX_UPLOAD_MB=500
# Optional path to soffice for legacy .doc/.ppt support.
EHELP_LIBREOFFICE_PATH=

# OCR for scanned PDFs (needs the tesseract binary with eng.traineddata)
EHELP_OCR_ENABLED=0
EHELP_TESSERACT_PATH=

# Hybrid search: keyword (BM25) + semantic (nomic-embed-text through Ollama)
EHELP_EMBED_ENABLED=0
EHELP_EMBED_MODEL=nomic-embed-text
EHELP_EMBED_MIN_SCORE=0.55
# Chroma stores vectors in <data dir>/chroma by default; set a path, or a server as host:port
EHELP_CHROMA_PATH=
EHELP_CHROMA_URL=
