# Where uploaded files and the SQLite database live.
EHELP_DATA_DIR=./data
# Local development only: treat every request as this admin when no iv-user header is present.
EHELP_DEV_ADMIN=0
# Maximum upload size in MB.
EHELP_MAX_UPLOAD_MB=500
# Optional path to soffice for legacy .doc/.ppt support.
EHELP_LIBREOFFICE_PATH=
