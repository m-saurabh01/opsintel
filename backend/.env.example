# Copy to .env (same folder you run `opsintel` from). Paths may be absolute; on Windows use forward slashes or escaped backslashes.
OPSINTEL_DATA_DIR=./data
API_HOST=127.0.0.1
API_PORT=8000

# SQLite
SQLITE_CACHE_MB=128
SQLITE_BUSY_TIMEOUT_MS=5000

# Indexing
MAX_FILE_SIZE_MB=20
CHUNK_LINES=50
CHUNK_MAX_CHARS=8000
# Document parsers (PDF/Word/Excel/ODS) run in a separate process with this time limit
PARSE_TIMEOUT_S=120
# Cache of parsed documents keyed by content hash; identical files are parsed once
PARSE_CACHE_MAX_MB=512
# Scanned PDF OCR is opt-in. Install Tesseract with the eng language data.
OCR_ENABLED=false
# TESSERACT_PATH=C:/Program Files/Tesseract-OCR/tesseract.exe
# Needed only for legacy .doc files; auto-detected if on PATH or in the default install folder
# LIBREOFFICE_PATH=C:/Program Files/LibreOffice/program/soffice.exe
# JSON list; replaces the default exclusion list entirely
# EXCLUDED_DIRS=[".git","node_modules","__pycache__",".venv","dist","build","target"]

# Gitea
GITEA_URL=http://localhost:12345
# Optional browser-facing URL; set this when the UI reaches Gitea at a different address or under a path such as /gitea.
# GITEA_WEB_URL=http://localhost:12345/gitea
# GITEA_TOKEN=          (admin or read-only token; never commit it)
# GITEA_WEBHOOK_SECRET= (random string shared with the Gitea webhook)
GITEA_POLL_INTERVAL_S=300
GIT_TIMEOUT_S=900
AUTH_SESSION_TTL_S=28800
# Additional trusted browser origins (the local Vite dev origins are built in).
# AUTH_ALLOWED_ORIGINS=["https://opsintel.example.internal"]
# Local repository paths accepted by the admin UI; use one or more trusted parent directories.
LOCAL_REPO_ALLOWED_ROOTS=[]

# Background jobs
JOB_MAX_ATTEMPTS=5
JOB_BACKOFF_BASE_S=30
JOB_BACKOFF_MAX_S=3600
QUEUE_MAX_QUEUED=1000
FILE_MAX_ATTEMPTS=3

# Optional local embeddings add related results to unified search when available.
SEMANTIC_SEARCH_ENABLED=false
# Dev: nomic-embed-text-v1.5 imported as nomic-embed-text (devtools/ollama/Modelfile.nomic); MiniLM: opsintel-embed
# OLLAMA_EMBED_MODEL=nomic-embed-text

# Search / viewer
SEARCH_PAGE_SIZE_MAX=100
VIEWER_MAX_LINES=2000

# Ollama (dev: Phi-3-mini imported as opsintel-dev; Windows: set the installed model tag)
AI_ENABLED=true
AI_DAILY_REQUEST_LIMIT=20
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=opsintel-dev
OLLAMA_MIN_VERSION=0.9.0
OLLAMA_KEEP_ALIVE=10m

# AI question answering (M6, localhost only until M5 authentication)
AI_MAX_QUEUE=4
AI_MAX_CONCURRENCY=1
AI_NUM_CTX=4096
AI_MAX_TOKENS=512
AI_TIMEOUT_S=180
AI_RETRIEVAL_TOP_K=4
AI_CONTEXT_CHARS=2500
AI_CACHE_TTL_S=900
AI_CACHE_MAX_ENTRIES=500

# Resource governor
WORKER_MIN_FREE_RAM_MB=1500
